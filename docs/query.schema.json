{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/latchset/crypto-auditing/docs/query.schema.json",
  "title": "crypto-auditing query output format",
  "description": "Output format of crau-query command",
  "$defs": {
    "Span": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "context": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
          "origin": { "type": "string", "pattern": "^([0-9a-f]{2})*$" },
          "executable": { "type": "string" },
          "start": { "type": "number" },
          "end": { "type": "number" },
          "events": {
            "type": "object",
            "properties": {
              "name": { "type": "string" }
            },
            "patternProperties": {
              "^[^:]+::.+$": {
                "oneOf": [
                  { "type": "integer" },
                  { "type": "string" },
                  {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 0, "maximum": 255 }
                  }
                ]
              }
            },
            "additionalProperties": true,
            "required": ["name"]
          },
          "spans": { "$ref": "#/$defs/Span" }
        },
        "required": ["context", "origin", "executable", "start", "end", "events"]
      }
    }
  },
  "$ref": "#/$defs/Span"
}
